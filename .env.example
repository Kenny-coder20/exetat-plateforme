# Clé API Anthropic (console.anthropic.com) — nécessaire pour la génération automatique
ANTHROPIC_API_KEY=sk-ant-...
# Identifiant du modèle IA utilisé pour la génération (modifiable)
MODELE_IA=claude-sonnet-5-5
# Emplacement de la base (facultatif)
# EXETAT_DB=data/exetat.sqlite
# Mot de passe de l'atelier (obligatoire dès que la plateforme est en ligne ; vide = pas de protection en local)
ATELIER_UTILISATEUR=atelier
ATELIER_MOT_DE_PASSE=
# Base PostgreSQL (Render la renseigne automatiquement ; vide = SQLite local)
# DATABASE_URL=

# Double relecture : 2 enseignants doivent concorder avec la clé avant publication (1 par défaut)
RELECTURES_REQUISES=1
# Matière Actualité : fenêtre temporelle fixée par le jury (AAAA-MM-JJ). Par défaut : 1er janvier de l'année précédente → aujourd'hui.
ACTUALITE_DEBUT=
ACTUALITE_FIN=
# Nombre maximal de recherches web par commande de génération d'Actualité
ACTUALITE_RECHERCHES_MAX=10
